# Copy to .env.worker in the repository root, fill values there, then chmod 0600.
# The real file is excluded by both .gitignore and .dockerignore.
AI_VIDEO_EDITOR_API_TOKEN=replace-with-a-long-random-application-token
GRADIVO_VIDEO_CALLBACK_TOKEN=replace-with-a-different-long-random-callback-token
GRADIVO_VIDEO_CALLBACK_BASE_URL=https://gradmin.com.hr
MAX_NUMBER_OF_JOBS=1

# Worker-only Google OAuth credentials. Do not reuse Gradivo's refresh token.
GOOGLE_DRIVE_CLIENT_ID=replace-me
GOOGLE_DRIVE_CLIENT_SECRET=replace-me
GOOGLE_DRIVE_REFRESH_TOKEN=replace-me

# Dedicated private DEV R2 bucket; worker key is bucket-scoped Object Read & Write.
VIDEO_PROCESSING_S3_ENDPOINT_URL=https://replace-account-id.r2.cloudflarestorage.com
VIDEO_PROCESSING_S3_BUCKET=replace-dev-bucket
VIDEO_PROCESSING_S3_ACCESS_KEY_ID=replace-me
VIDEO_PROCESSING_S3_SECRET_ACCESS_KEY=replace-me

# Worker-owned student_video.v1 settings. Acceptance snapshots these exact values
# in SQLite before media work; changing them affects only later job UUIDs.
# These are integration defaults, not a settled production-quality profile.
VIDEO_PROCESSING_RENDER_CODEC=libx264
VIDEO_PROCESSING_RENDER_CRF=28
VIDEO_PROCESSING_RENDER_PRESET=ultrafast
VIDEO_PROCESSING_RENDER_CROSSFADE_MS=30

# Media-provider keys currently used by the analysis pipeline.
ELEVENLABS_API_KEY=replace-me
GEMINI_API_KEY=replace-me
OPENROUTER_API_KEY=replace-me
OPENAI_API_KEY=replace-me

# Execution deadlines (seconds, excluding Gradivo queue wait). Retry is manual.
VIDEO_PROCESSING_ANALYSIS_TIMEOUT_SECONDS=14400
VIDEO_PROCESSING_RENDER_TIMEOUT_SECONDS=14400
