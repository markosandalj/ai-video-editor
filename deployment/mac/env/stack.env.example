# Non-secret Docker Compose interpolation values. Copy to .env.stack.local in
# the repository root; that local file is ignored by Git and Docker builds.
# Replace both image references with versions/digests intentionally approved for rollout.
AI_VIDEO_WORKER_IMAGE=ai-video-worker:f779947
CLOUDFLARED_IMAGE=cloudflare/cloudflared:2026.7.3

# All paths must be absolute and owned by the dedicated non-admin Docker account.
AI_VIDEO_WORKER_ENV_FILE=/absolute/path/to/ai-video-editor/.env.worker
AI_VIDEO_CLOUDFLARED_ENV_FILE=/absolute/path/to/ai-video-editor/.env.cloudflared
AI_VIDEO_WORKER_STATE_DIR=/Users/ai-video-worker/ai-video-worker-data/state
AI_VIDEO_WORKER_SCRATCH_DIR=/Users/ai-video-worker/ai-video-worker-data/scratch
AI_VIDEO_WORKER_LOG_DIR=/Users/ai-video-worker/ai-video-worker-data/logs
